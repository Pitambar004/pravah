# PRAVAH Streamlit dashboard image (CPU only; no model, no torch).
#
#   docker buildx build --platform linux/arm64,linux/amd64 -f infra/docker/Dockerfile.dashboard \
#       -t <registry>/pravah-dashboard:<tag> --push .
#
# python:3.11-slim is the upstream multi-arch Python image; pin its digest once built.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false STREAMLIT_SERVER_HEADLESS=true \
    PRAVAH_API_URL=http://api.service:8000 PRAVAH_OUTPUTS_DIR=/data/outputs/predictions

WORKDIR /opt/pravah
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[ui]"
COPY app ./app
COPY .streamlit ./.streamlit
COPY config ./config
COPY scripts/fuzzball/start_dashboard.sh ./scripts/fuzzball/start_dashboard.sh

EXPOSE 8501
CMD ["sh", "scripts/fuzzball/start_dashboard.sh"]
