# Public defaults only. Copy to .env for local overrides; never commit credentials.
PRAVAH_API_URL=http://127.0.0.1:8006
PRAVAH_NEPAL_API_URL=http://127.0.0.1:8006
PRAVAH_INTERNAL_API_URL=http://api.service:8000
PRAVAH_API_PORT=8006
PRAVAH_UI_PORT=8506
PRAVAH_BIND_HOST=127.0.0.1
PRAVAH_SERVICE_BIND_HOST=0.0.0.0
PRAVAH_LOCAL_SCHEME=http
PRAVAH_CARTO_BASEMAP_API_KEY=
PRAVAH_API_TOKEN=
PRAVAH_FB_ENDPOINT_TOKEN=
PRAVAH_DASHBOARD_PASSCODE=

# Public data providers
PRAVAH_DHM_RIVER_WATCH_URL=https://dhm.gov.np/hydrology/river-watch
PRAVAH_DHM_STATION_URL=https://dhm.gov.np/hydrology/hms-Single/{id}
PRAVAH_DHM_HISTORY_URL=https://dhm.gov.np/site/getRiverWatchBySeriesId_Single
PRAVAH_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
PRAVAH_OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
PRAVAH_USGS_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
PRAVAH_USGS_EVENT_URL=https://earthquake.usgs.gov/earthquakes/eventpage/{id}
PRAVAH_USGS_EVENT_DATA_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/detail/{id}.geojson
PRAVAH_CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
PRAVAH_CDSE_SEARCH_URL=https://stac.dataspace.copernicus.eu/v1/search
PRAVAH_PREVIEW_ALLOWED_HOSTS=datahub.creodias.eu,catalogue.dataspace.copernicus.eu
PRAVAH_GCP_BUCKET_API_URL=https://storage.googleapis.com/storage/v1/b/gcp-public-data-sentinel-2/o
PRAVAH_GCP_BUCKET_URL=https://storage.googleapis.com/gcp-public-data-sentinel-2/
PRAVAH_GEOFABRIK_NEPAL_URL=https://download.geofabrik.de/asia/nepal-latest.osm.pbf
PRAVAH_OVERPASS_URL=https://overpass-api.de/api/interpreter
PRAVAH_GLO_URL=https://zenodo.org/records/17802334
PRAVAH_GLO_API_URL=https://zenodo.org/api/records/17802334
PRAVAH_ICIMOD_API_URL=https://lib.icimod.org/api/records/qdvc1-tc123
PRAVAH_ICIMOD_REPORT_URL=https://lib.icimod.org/records/qdvc1-tc123
PRAVAH_ICIMOD_FINDINGS_URL=https://www.icimod.org/press-releases/second-major-himalayan-flood-in-seven-weeks-raises-new-questions-about-mountain-risk/
PRAVAH_DHM_EVENT_REPORT_URL=https://hydrology.gov.np/cm/files/Bhotekoshi-Trishuli-Narayani_Flood_Report_CHWRR_1%20_1787809133090.pdf
PRAVAH_NDRRMA_2025_REPORT_URL=https://ndrrma.gov.np/mediafiles/publications/Rasuwagadhi_Flood_Sitrep1_08072025_.pdf
PRAVAH_WHO_EVENT_URL=https://www.who.int/nepal/emergencies/2026-rasuwa-flash-floods
PRAVAH_NASA_ELEVATION_URL=https://earth.gsfc.nasa.gov/gwm
PRAVAH_DEM_README_URL=https://copernicus-dem-30m.s3.amazonaws.com/readme.html
PRAVAH_OSM_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
PRAVAH_SEN1FLOODS_URL=https://github.com/cloudtostreet/Sen1Floods11
PRAVAH_CDSE_DOCS_URL=https://documentation.dataspace.copernicus.eu/APIs/STAC.html
PRAVAH_PRITHVI_MODEL_URL=https://huggingface.co/ibm-nasa-geospatial/Prithvi-EO-2.0-300M-TL-Sen1Floods11
