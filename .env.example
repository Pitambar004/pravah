# Basemaps and browser assets. {z}/{x}/{y} are Leaflet tile placeholders.
PRAVAH_CARTO_TILE_URL=https://basemaps.cartocdn.com/rastertiles/{style}/{z}/{x}/{y}{r}.png
PRAVAH_BASEMAP_DARK_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
PRAVAH_BASEMAP_LABELS_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}
PRAVAH_BASEMAP_LIGHT_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}
PRAVAH_BASEMAP_IMAGERY_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
PRAVAH_BASEMAP_TERRAIN_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
PRAVAH_LEAFLET_CSS_URL=https://unpkg.com/leaflet@{version}/dist/leaflet.css
PRAVAH_LEAFLET_JS_URL=https://unpkg.com/leaflet@{version}/dist/leaflet.js
PRAVAH_FONT_CSS_URL="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
PRAVAH_ICONS_CSS_URL="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..500,0,0&display=block"

# Fuzzball access is configured when Team 12 access is available.
FUZZBALL_CLUSTER=
FUZZBALL_GROUP=team12
FUZZBALL_API_URL=
FUZZBALL_OIDC_URL=
CONTAINER_IMAGE=
SHARED_VOLUME_NAME=
PRAVAH_RUN_ID=
