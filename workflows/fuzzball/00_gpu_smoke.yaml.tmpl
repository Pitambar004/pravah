# Gate C: prove CUDA inside the PRAVAH API image on one Team 12 GB10.
# TEMPLATE — render with scripts/fuzzball/render_workflow.py; NOT validated on v4.3.1 yet.
version: v4

volumes:
  dataset:
    use: "{{VOLUME_PROVISIONER}}"
    name: "{{VOLUME_NAME}}"

jobs:
  gpu-smoke:
    image:
      uri: "{{API_IMAGE}}"
    mounts:
      /data:
        volume: dataset
    command: ["python", "/opt/pravah/scripts/fuzzball/gpu_smoke.py", "--out", "/data/outputs/evaluation"]
    resource:
      cpu:
        cores: 4
        affinity: NUMA
      memory:
        size: 16GiB
      devices:
        nvidia.com/gpu: 1
